os: mac
app.bundle: com.stablyai.orca
-
# Orca (editor ADE de Stably AI).
# OJO: estos atajos son los convencionales de un editor tipo VS Code.
# Verifica cada uno en la app y corrige el que no coincida.
palette open: key(cmd-shift-p)
file open: key(cmd-p)
side bar: key(cmd-b)
panel toggle: key(cmd-j)
comment line: key(cmd-/)
find here: key(cmd-f)
find project: key(cmd-shift-f)
