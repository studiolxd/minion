-
# --- Ventanas ---
window close: key(cmd-w)
window mini: key(cmd-m)
window full: key(ctrl-cmd-f)
window new: key(cmd-n)

# --- Aplicaciones ---
app hide: key(cmd-h)
app switch: key(cmd-tab)

# --- Escritorios y sistema ---
desk right: key(ctrl-right)
desk left: key(ctrl-left)
mission view: key(ctrl-up)
spot light: key(cmd-space)

# --- Capturas ---
shoot area: key(cmd-shift-4)
shoot screen: key(cmd-shift-3)
